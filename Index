function startRecording() {
  if (!session || session.role !== 'TEACHER') {
    showMsg('recordMsg', 'Sila log masuk sebagai guru.', true);
    return;
  }

  const parentOrigin = window.location.origin;
  const recorderUrl =
    'https://YOUR-USERNAME.github.io/emotion-recorder/' +
    '?parentOrigin=' + encodeURIComponent(parentOrigin);

  recorderWindow = window.open(
    recorderUrl,
    'JKEAudioRecorder',
    'width=600,height=650'
  );

  if (!recorderWindow) {
    showMsg(
      'recordMsg',
      'Tetingkap rakaman disekat. Benarkan pop-up untuk aplikasi ini, kemudian cuba lagi.',
      true
    );
    return;
  }

  recordedBlob = null;
  recordedDurationSeconds = 0;
  document.getElementById('uploadRec').disabled = true;
  document.getElementById('audioPreview').classList.add('hidden');
  document.getElementById('recStatus').textContent =
    'Halaman rakaman dibuka. Mulakan rakaman di tetingkap tersebut.';
  hide('recordMsg');
}

function stopRecording() {
  // Rakaman dikawal melalui tetingkap Recorder.html.
  // Klik "Hentikan Rakaman" di tetingkap tersebut.
  if (recorderWindow && !recorderWindow.closed) {
    recorderWindow.focus();
  }
}

