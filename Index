function stopTracks() {
  if (mediaRecorder && mediaRecorder.stream) mediaRecorder.stream.getTracks().forEach(t => t.stop());
}
async function uploadRecording() {
  if (!recordedBlob || !session) return;
  if (recordedBlob.size > 8*1024*1024) { showMsg('recordMsg','录音超过 8 MB，请重新录制较短内容。',true); return; }
  const studentId = document.getElementById('recordStudent').value;
  //const duration = Math.max(1, Math.round((Date.now()-recordStartedAt)/1000));
  const duration = recordedDurationSeconds;
  const reader = new FileReader();
  reader.onloadend = () => {
    document.getElementById('uploadRec').disabled = true;
    google.script.run.withSuccessHandler(() => {
      showMsg('recordMsg',`已提交 ${studentId} 的录音。`);
      recordedBlob = null;
      document.getElementById('audioPreview').classList.add('hidden');
      loadTeacherRecords();
    }).withFailureHandler(err => {
      document.getElementById('uploadRec').disabled = false;
      showMsg('recordMsg',err.message || String(err),true);
    }).submitTeacherExitTicket(session.token, studentId, reader.result, recordedBlob.type, Math.min(60,duration));
  };
  reader.readAsDataURL(recordedBlob);
}
function loadTeacherRecords() {
  if (!session || session.role !== 'TEACHER') return;
  google.script.run.withSuccessHandler(records => {
    const box = document.getElementById('teacherRecords');
    if (!records.length) { box.innerHTML = '<p class="muted">还没有录音记录。</p>'; return; }
    box.innerHTML = records.map(r => `
      <div class="item">
        <div class="row"><div><b>${escapeHtml(r.studentId)}</b> <span class="pill">${r.published?'已发布':'草稿 / 未发布'}</span><p class="muted">${escapeHtml(String(r.createdAt))} · ${r.duration} 秒</p></div>
        <div><button class="secondary" onclick="playAudio('${r.id}','${r.fileId}')">播放录音</button></div></div>
        <label>表现等级</label>
        <select id="level_${r.id}">
          <option value="">请选择</option>
          ${['Perlu Bimbingan','Sedang Berkembang','Baik','Sangat Baik'].map(x=>`<option ${r.level===x?'selected':''}>${x}</option>`).join('')}
        </select>
        <label>教师评语</label><textarea id="comment_${r.id}" rows="2" maxlength="1000" placeholder="填写具体、鼓励性的评语">${escapeHtml(r.comment)}</textarea>
        <button onclick="saveOne('${r.id}',false)">保存草稿</button>
        <button class="secondary" onclick="saveOne('${r.id}',true)">发布给学生</button>
        <div id="status_${r.id}" class="muted"></div>
        <audio id="audio_${r.id}" controls class="hidden" style="width:100%;margin-top:8px"></audio>
      </div>`).join('');
  }).withFailureHandler(err => {
    document.getElementById('teacherRecords').textContent = err.message || String(err);
  }).getTeacherData(session.token);
}
function playAudio(submissionId, fileId) {
  google.script.run.withSuccessHandler(dataUrl => {
    const audio = document.getElementById('audio_'+submissionId);
    audio.src = dataUrl; audio.classList.remove('hidden'); audio.play();
  }).withFailureHandler(err => alert(err.message || String(err))).getAudioDataUrl(session.token,fileId);
}
function saveOne(id, publish) {
  const level = document.getElementById('level_'+id).value;
  const comment = document.getElementById('comment_'+id).value;
  if (!level) { document.getElementById('status_'+id).textContent = '请先选择表现等级。'; return; }
  google.script.run.withSuccessHandler(() => {
    document.getElementById('status_'+id).textContent = publish ? '已发布，学生登录后可查看。' : '草稿已保存。';
    loadTeacherRecords();
  }).withFailureHandler(err => {
    document.getElementById('status_'+id).textContent = err.message || String(err);
  }).saveFeedback(session.token,id,level,comment,publish);
}
function escapeHtml(value) {
  return String(value ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
</script>
window.addEventListener('message', async event => {
  // Accept messages only from the expected recorder page and its window.
  if (event.origin !== RECORDER_ORIGIN) return;
  if (!recorderWindow || event.source !== recorderWindow) return;

  const message = event.data;
  if (!message || message.type !== 'JKE_AUDIO_READY') return;

  try {
    if (typeof message.dataUrl !== 'string' ||
        !message.dataUrl.startsWith('data:audio/')) {
      throw new Error('Format rakaman tidak sah.');
    }

    const response = await fetch(message.dataUrl);
    const blob = await response.blob();

    if (!blob.size || blob.size > 8 * 1024 * 1024) {
      throw new Error('Rakaman kosong atau melebihi had 8 MB.');
    }

    recordedBlob = blob;
    recordedDurationSeconds = Math.min(
      60,
      Math.max(1, Number(message.durationSeconds) || 1)
    );

    const audio = document.getElementById('audioPreview');
    audio.src = URL.createObjectURL(recordedBlob);
    audio.classList.remove('hidden');

    document.getElementById('uploadRec').disabled = false;
    document.getElementById('recStatus').textContent =
      `Rakaman diterima (${recordedDurationSeconds} saat). ` +
      'Dengar dahulu, kemudian klik Hantar Rakaman.';
    showMsg('recordMsg', 'Rakaman diterima. Belum disimpan ke Google Drive.');

  } catch (error) {
    recordedBlob = null;
    document.getElementById('uploadRec').disabled = true;
    showMsg('recordMsg', error.message || String(error), true);
  }
});
